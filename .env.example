# Server port (default: 3001)
PORT=3001

# CORS origin for the frontend dev server. Leave commented to allow any
# http://localhost:<port> (Vite moves to 5174+ when 5173 is busy).
# CORS_ORIGIN=http://localhost:5173

# Directory for storing processed dance data (default: ./data/dances).
# Note: the sessions route treats DATA_DIR as the data *root* (sessions go to
# $DATA_DIR/sessions), so leave this commented unless you need to move both.
# DATA_DIR=./data/dances

# SQLite database path (default: ./data/groovy.db)
# DB_PATH=./data/groovy.db

# --- DanceCraft AI coach (POST /api/coach) ---
# Anthropic API key. Leave empty to use the built-in (offline) coach.
ANTHROPIC_API_KEY=

# Claude model used by the coach (default: claude-sonnet-5-5). CLAUDE_MODEL also works.
COACH_MODEL=claude-sonnet-5-5

# Reasoning effort for coach calls: low | medium | high (default: low).
# (Not CLAUDE_EFFORT: Claude Code exports that name to child processes.)
COACH_EFFORT=low

# Set to 1 to force the built-in coach even when a key is configured
COACH_OFFLINE=0

# Windows: point the offline pose pipeline at the venv Python
# PYTHON_PATH=.venv/Scripts/python.exe
